<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <parent>
        <groupId>org.wso2.carbon</groupId>
        <artifactId>carbon-kernel</artifactId>
        <version>4.12.61-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>org.wso2.carbon.server</artifactId>
    <packaging>jar</packaging>
    <name>WSO2 Carbon - Standalone Server</name>
    <description>The stadalone server code</description>

    <dependencies>
        <dependency>
            <groupId>org.wso2.org.ops4j.pax.logging</groupId>
            <artifactId>pax-logging-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.orbit.xerces</groupId>
            <artifactId>xercesImpl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.config.mapper</groupId>
            <artifactId>config-mapper</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <hsm.it.excluded.groups>hsm-it</hsm.it.excluded.groups>
        <hsm.it.groups/>
    </properties>

    <profiles>
        <profile>
            <!-- Token integration tests: -Dhsm.it.cfg (SunPKCS11 config file), -Dhsm.it.pin and -Dhsm.it.alias (RSA key
                 pair on that token, not extractable). SoftHSM 2.x (set SOFTHSM2_CONF) supports RSA-OAEP with SHA-1
                 only, so the SHA-2 cases are skipped there; NSS softoken (nssLibraryDirectory and nssSecmodDirectory
                 in the config) covers them. -->
            <id>hsm-it</id>
            <properties>
                <hsm.it.excluded.groups/>
                <hsm.it.groups>hsm-it</hsm.it.groups>
            </properties>
        </profile>
    </profiles>

    <build>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                    <include>**/*.xsl</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <inherited>false</inherited>
                <configuration>
                    <!--<forkMode>pertest</forkMode>-->
                    <!--<argLine>-enableassertions</argLine>
                    <testFailureIgnore>false</testFailureIgnore>-->
                    <excludes>
                        <exclude>**/*Abstract*.java</exclude>
                        <exclude>**/*CryptoUtilTest*.java</exclude>
                        <exclude>**/TomcatServerTest.java</exclude>
                    </excludes>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <systemProperties>
                        <property>
                            <name>maven.test.haltafterfailure</name>
                            <value>false</value>
                        </property>
                    </systemProperties>
                    <!-- Same module access as the start scripts give the server (PKCS11OAEPProvider). @{argLine} keeps
                         the JaCoCo agent options set by the parent. -->
                    <argLine>@{argLine} --add-opens=jdk.crypto.cryptoki/sun.security.pkcs11=ALL-UNNAMED --add-opens=jdk.crypto.cryptoki/sun.security.pkcs11.wrapper=ALL-UNNAMED</argLine>
                    <!-- Tests that need a SoftHSM token run only with -Phsm-it. -->
                    <excludedGroups>${hsm.it.excluded.groups}</excludedGroups>
                    <groups>${hsm.it.groups}</groups>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
